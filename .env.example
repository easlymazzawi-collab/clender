# ══════════════════════════════════════════════════════════════
#  Forum Converter Bot + Telethon Forwarder — Configuration
# ══════════════════════════════════════════════════════════════

# ── Telegram Bot (python-telegram-bot) ──────────────────────
# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Bot username WITHOUT @ (e.g. "hongcliprobot")
# Used to build deep links: t.me/BOT_USERNAME?start=TOKEN
BOT_USERNAME=your_bot_username

# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=123456789,987654321

# ── Telethon (User Account — Forum Forwarder) ────────────────
# Get from https://my.telegram.org/apps
TELETHON_API_ID=12345678
TELETHON_API_HASH=your_api_hash_here

# Your phone number (with country code)
TELETHON_PHONE=+84901234567

# Session file name (saved in forwarder_state/)
TELETHON_SESSION=session_main

# ── Forum IDs (for Bot auto-clone) ──────────────────────────
# Negative number for supergroups/channels
SOURCE_FORUM_ID=-1001234567890
DEST_FORUM_ID=-1009876543210

# ── Web Server ───────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Public URL (used to build share links)
# Example: https://yourdomain.com  or  http://your.ip:5000
BASE_URL=http://localhost:5000

# Flask secret key (change this in production!)
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Database ─────────────────────────────────────────────────
DB_PATH=database/forum_bot.db

# ── Media Storage ────────────────────────────────────────────
MEDIA_DIR=media
MAX_FILE_SIZE_MB=50

# ── Clone / Forward Settings ─────────────────────────────────
# Delay between forwarded messages (seconds) to avoid flood limits
CLONE_DELAY_SECONDS=1.5
THUMBNAIL_QUALITY=85

# ── Caption Template ─────────────────────────────────────────
# {url} will be replaced with the actual share link
LINK_CAPTION_TEMPLATE=🔗 Nhấp vào link để xem:\n{url}
