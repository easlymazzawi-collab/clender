[Unit]
Description=Forum Converter Bot (Bot + Web + Forwarder)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Đổi User và đường dẫn cho đúng VPS của bạn
User=ubuntu
WorkingDirectory=/home/ubuntu/clender
ExecStart=/home/ubuntu/clender/venv/bin/python run.py
Restart=always
RestartSec=5
# Ghi log ra journald (xem bằng: journalctl -u forumbot -f)
StandardOutput=journal
StandardError=journal
# Tự khởi động lại nếu crash, không giới hạn số lần
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
